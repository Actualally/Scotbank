<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account — Scotbank Investments</title>
    <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
    <div style="position: relative;">
            <a href="/logout" class="btn btn-withdraw" style="position: absolute; top: -20px; right: -450px;">Log Out</a>
    </div>
    <div class="card">
        <h1>Welcome, {{name}}</h1>
        <p class="account-id">Account: {{accountId}}</p>
        <div class="balance-display">£{{balance}}</div>

        {{#if success}}
            <div class="msg-success">{{success}}</div>
        {{/if}}
        {{#if error}}
            <div class="msg-error">{{error}}</div>
        {{/if}}
        <div class="actions">
            <a href="/account/deposit" class="btn btn-deposit">Deposit</a>
            <a href="/account/withdraw" class="btn btn-withdraw">Withdraw</a>
        </div>

        {{#if transactions}}
            <button class="btn btn-history" onclick="document.getElementById('historyModal').style.display='flex'">
                View Transaction History
            </button>
        {{/if}}
    </div>

    {{#if transactions}}
    <div id="historyModal" class="modal-overlay" onclick="if(event.target===this)this.style.display='none'">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Transaction History</h2>
                <button class="modal-close" onclick="document.getElementById('historyModal').style.display='none'">&times;</button>
            </div>
            <div class="modal-body">
                <table class="transaction-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each transactions}}
                        <tr>
                            <td>{{this.date}}</td>
                            <td>{{this.type}}</td>
                            <td>£{{this.amount}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/if}}
</body>
</html>